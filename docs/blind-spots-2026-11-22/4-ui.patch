 TEST_FILE_RE = re.compile(r"\.(test|spec)\.[^/]+$|_test\.go$|(^|/)test_[^/]+\.py$")
 TEST_RE = re.compile(r"(^|/)(__tests__|tests?|spec|e2e)/|\.(test|spec)\.[^/]+$|_test\.go$|(^|/)test_[^/]+\.py$")
